{
  "name": "mba-backoffice-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && node build-static.mjs",
    "dev": "npm run dev:local",
    "dev:local": "npm run build && vite preview --outDir dist --host localhost --port 5173 --strictPort",
    "preview": "vite preview --outDir dist --host 0.0.0.0 --port 5173 --strictPort",
    "test:hardening": "node tests/hardening.test.mjs && node tests/portfolio-policy.test.mjs",
    "test:metabase": "node tests/metabase-only.test.mjs",
    "dev:ux": "vite --config vite.ux.config.ts --host 127.0.0.1",
    "build:ux": "vite build --config vite.ux.config.ts",
    "test:ux": "node tests/operational-ux.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
